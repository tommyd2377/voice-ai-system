# OpenAI realtime API key
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# OpenAI realtime WebSocket endpoint
OPENAI_REALTIME_ENDPOINT=wss://api.openai.com/v1/realtime?model=gpt-realtime-2

# Primary Twilio phone number used for voice calls
PHONE_RELAY_NUMBER=+15555551234

# WebSocket endpoint for Twilio <Stream>
# Can be set as either:
# - wss://your-app-domain/realtime
# - your-app-domain/realtime
TWILIO_STREAM_URL=wss://your-app-domain/realtime

# Owner phone used to recognize Tom/self-calls
TWILIO_OWNER_PHONE=+15555559876

# Local port fallback (ignored in cloud hosting)
PORT=8080

# Firebase is currently dormant for the voice assistant flow.
# Keep this commented/optional unless you intentionally re-enable Firebase later.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# TaskDeck shared database access for Victoria.
# Local development can point directly at the same SQLite/libSQL file used by the TaskDeck Next.js app.
# Production should use the same Turso/libSQL URL and auth token configured for TaskDeck.
TASKDECK_DATABASE_URL=file:/Users/thomasdevito/Projects/taskdeck/data/taskdeck.db
# TASKDECK_DATABASE_AUTH_TOKEN=
# APP_TIMEZONE=America/New_York
